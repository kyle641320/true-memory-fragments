[Unit]
Description=TMF narrow stateless model broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tmf-broker
Group=tmf-broker-arm
EnvironmentFile=/etc/tmf-model-broker/environment
Environment=TMF_BROKER_SOCKET=/run/tmf-model-broker/broker.sock
RuntimeDirectory=tmf-model-broker
RuntimeDirectoryMode=0750
ExecStart=/opt/tmf-model-broker/broker.py
Restart=on-failure
UMask=0117
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/tmf-model-broker

[Install]
WantedBy=multi-user.target
