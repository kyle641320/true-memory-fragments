{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kyle641320/true-memory-fragments",
  "title": "True Memory Fragments",
  "description": "Detect stale source context and retain traceable code-chain understanding for AI coding agents.",
  "version": "0.1.0-rc4",
  "repository": {
    "url": "https://github.com/kyle641320/true-memory-fragments",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "true-memory-fragments",
      "version": "0.1.0rc4",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "true-memory-fragments[java]==0.1.0rc4"
        },
        {
          "type": "positional",
          "value": "--from"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "tmf"
        },
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--repo",
          "value": "{repo_path}",
          "variables": {
            "repo_path": {
              "description": "Absolute path to the Git worktree to inspect.",
              "isRequired": true
            }
          }
        }
      ]
    }
  ]
}
